{
  "Jwt": {
    "Issuer": "SmartServiceRequestAPI",
    "Audience": "SmartServiceRequestClient",
    "ExpiryMinutes": "60"
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 600
    },
    "Ai": {
      "PermitLimit": 6,
      "WindowSeconds": 60
    },
    "TrustForwardedHeaders": false
  },

  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Workload": {
    "MaxActiveRequestsPerTechnician": 3
  },

  "Ai": {
    "Enabled": false,
    "Provider": "Groq",
    "TimeoutSeconds": 10,
    "DailyLimitPerUser": 15,
    "DailyLimitTotal": 150,
    "Groq": {
      "BaseUrl": "https://api.groq.com/openai/v1",
      "Model": "openai/gpt-oss-20b"
    },
    "Gemini": {
      "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "Model": "gemini-3.5-flash-lite"
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
