{
  "Jwt": {
    "Issuer": "SmartServiceRequestAPI",
    "Audience": "SmartServiceRequestClient",
    "ExpiryMinutes": "60"
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Register": {
      "PermitLimit": 10,
      "WindowSeconds": 600
    },
    "TrustForwardedHeaders": false
  },

  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },

  "Workload": {
    "MaxActiveRequestsPerTechnician": 3
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
